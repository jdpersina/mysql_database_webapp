<h1>Customer Invoices</h1>

{{! READ table }}
<table>
    <thead>
        <tr>
            <th>Invoice ID</th>
            <th>Customer Name</th>
            <th>Item Count</th>
            <th>Items Provided</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the invoice details }}
        {{#each invoices}}
        <tr>
            <td>{{this.customerInvoiceID}}</td>
            <td>{{this.customerName}}</td>
            <td>{{this.itemCount}}</td>
            <td>{{this.items}}</td>

            {{! DELETE form }}
            <form id='delete_invoice_form'>
                <input type='hidden' name='delete_invoice_id' value='{{this.customerInvoiceID}}' />
                <td>
                    <button type='submit' class='btn-delete'>
                        Delete
                    </button>
                </td>
            </form>
        </tr>
        {{/each}}
    </tbody>
</table>

{{! CREATE form }}
<h2>Create New Invoice</h2>
<form class='cuForm' id='create_invoice_form'>
    <label for='create_invoice_customer'>Customer: </label>
    <select name='create_invoice_customer' id='create_invoice_customer' required>
        <option value='' disabled selected>Select a Customer</option>
        {{#each customers}}
        <option value='{{this.customerID}}'>{{this.customerName}}</option>
        {{/each}}
    </select>

    <label for='create_invoice_fooditem'>Food/Drink Item: </label>
    <select name='create_invoice_fooditem' id='create_invoice_fooditem' required>
        <option value='' disabled selected>Select an Item</option>
        {{#each foodItems}}
        <option value='{{this.foodItemID}}'>{{this.itemName}}</option>
        {{/each}}
    </select>

    <label for='create_invoice_quantity'>Quantity:</label>
    <input type='number' name='create_invoice_quantity' id='create_invoice_quantity' min='1' value='1' required />

    <input type='submit' value='Create Invoice' />
</form>

{{! UPDATE form }}
<h2>Update an Invoice</h2>
<form class='cuForm' id='update_invoice_form'>
    <label for='update_invoice_id'>Invoice to Update: </label>
    <select name='update_invoice_id' id='update_invoice_id' required>
        <option value='' disabled selected>Select an Invoice</option>
        {{#each invoices}}
        <option value='{{this.customerInvoiceID}}'>
            Invoice #{{this.customerInvoiceID}} - {{this.customerName}}
        </option>
        {{/each}}
    </select>

    <label for='update_invoice_customer'>Customer: </label>
    <select name='update_invoice_customer' id='update_invoice_customer'>
        <option value='' disabled selected>Select a Customer</option>
        {{#each customers}}
        <option value='{{this.customerID}}'>{{this.customerName}}</option>
        {{/each}}
    </select>

    <label for='update_invoice_fooditem'>Food/Drink Item: </label>
    <select name='update_invoice_fooditem' id='update_invoice_fooditem'>
        <option value='' disabled selected>Select an Item</option>
        {{#each foodItems}}
        <option value='{{this.foodItemID}}'>{{this.itemName}}</option>
        {{/each}}
    </select>

    <label for='update_invoice_quantity'>Quantity: </label>
    <input type='number' name='update_invoice_quantity' id='update_invoice_quantity' min='1' />

    <input type='submit' value='Update Invoice' />
</form>