{{! UPDATE form }}
<h1>Update a Supplier</h2>
<form class='cuForm' id='update_supplier_form'>
    <label for='update_supplier_id'>Supplier to Update: </label>
    <select name='update_supplier_id' id='update_supplier_id' required>
        <option value='' disabled selected>Select a Supplier</option>
        {{#each suppliers}}
        <option value='{{this.supplierID}}' required>
            {{this.supplierID}}
            -
            {{this.supplierName}}
        </option>
        {{/each}}
    </select>

    <label for='update_supplier_gullibility'>Gullibility Rating: </label>
    <input type='number' name='update_supplier_gullibility' id='update_supplier_gullibility' min='0' />

    <label for='update_supplier_blackmailable'>Blackmailable: </label>
    <select name='update_supplier_blackmailable' id='update_supplier_blackmailable'>
        <option value='' disabled selected>Select Option</option>
        <option value='0'>No</option>
        <option value='1'>Yes</option>
    </select>

    <label for='update_supplier_culture'>Culture: </label>
    <select name='update_supplier_culture' id='update_supplier_culture'>
        <option value='NULL' disabled selected>Select a Culture</option>
        <option value='NULL'>&lt; None &gt;</option>
        {{#each cultures}}
        <option value='{{this.cultureID}}'>
            {{this.cultureName}}
        </option>
        {{/each}}
    </select>

    <input type='submit' />
</form>
