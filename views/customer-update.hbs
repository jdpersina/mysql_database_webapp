{{! UPDATE form }}
<h1>Update a Customer</h2>
<form class='cuForm' id='update_customer_form'>
    <label for='update_customer_id'>Customer to Update: </label>
    <select name='update_customer_id' id='update_customer_id' required>
        <option value='' disabled selected>Select a Customer</option>
        {{#each customers}}
        <option value='{{this.customerID}}' required>
            {{this.customerID}}
            -
            {{this.customerName}}
        </option>
        {{/each}}
    </select>

    <label for='update_customer_gullibility'>Gullibility Rating: </label>
    <input type='number' name='update_customer_gullibility' id='update_customer_gullibility' min='0' />

    <label for='update_customer_blackmailable'>Blackmailable: </label>
    <select name='update_customer_blackmailable' id='update_customer_blackmailable'>
        <option value='' disabled selected>Select Option</option>
        <option value='0'>No</option>
        <option value='1'>Yes</option>
    </select>

    <label for='update_customer_culture'>Culture: </label>
    <select name='update_customer_culture' id='update_customer_culture'>
        <option value='NULL' disabled selected>Select a Culture</option>
        <option value='NULL'>&lt; None &gt;</option>
        {{#each cultures}}
        <option value='{{this.cultureID}}'>
            {{this.cultureName}}
        </option>
        {{/each}}
    </select>

    <label for='update_customer_favorite_food'>Favorite Food: </label>
    <select name='update_customer_favorite_food' id='update_customer_favorite_food'>
        <option value='NULL' disabled selected>Select a Food Item</option>
        <option value='NULL'>&lt; None &gt;</option>
        {{#each foodItems}}
        <option value='{{this.foodItemID}}'>
            {{this.foodName}}
        </option>
        {{/each}}
    </select>

    <input type='submit' />
</form>
