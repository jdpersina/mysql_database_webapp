<h1>Current Customers</h1>

<div>There are this many customers: {{customers.length}}</div>

{{! READ table }}
<table>
    <thead>
        <tr>
            <th>Customer Name</th>
            <th>Gullibility</th>
            <th>Blackmailable?</th>
            <th>Culture</th>
            <th>Favorite Food</th>
            <th>Delete?</th>
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the customerID, customerName, gullibilityRating, blackmailable, cultureID, favoriteFood }}
        {{#each customers}}
        <tr>
            {{!-- <td>{{this.customerID}}</td> --}}
            <td>{{this.customerName}}</td>
            <td>{{this.gullibility}}</td>
            <td>{{this.blackmailable}}</td>
            <td>{{this.cultureName}}</td>
            <td>{{this.favoriteFood}}</td>

            {{! DELETE form }}
            <form id='delete_customer_form' method='POST' action='/delete-customer'>
                <input type='hidden' name='delete_customer_id' value='{{this.customerID}}' />
                <input type='hidden' name='delete_customer_name' value='{{this.customerName}}' />
                <td>
                    <button type='submit'>
                        Delete
                    </button>
                </td>
            </form>
        </tr>
        {{/each}}
    </tbody>
</table>

<a href='/add-customer'>
    <button type='button'>
        Add New Customer
    </button>
</a>

<a href='/update-customer'>
    <button type='button'>
        Update Existing Customer
    </button>
</a>

