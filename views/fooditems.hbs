<h1>Menu</h1>

<div>There are {{foodItems.length}} food items.</div>

<table border="1" cellspacing="0" cellpadding="5">
    <thead>
        <tr>
            <th>Food Item ID</th>
            <th>Item Name</th>
            <th>Culture</th>
        </tr>
    </thead>
    <tbody>
        {{#each foodItems}}
        <tr>
            <td>{{this.foodItemID}}</td>
            <td>{{this.itemName}}</td>
            <td>{{this.cultureName}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>
