<h1>Menu</h1>

<div>There are {{foodItems.length}} food items.</div>
<div>Food Items Are listed per Culture in Alphabetical Order</div>

<table border="1" cellspacing="0" cellpadding="5">
    <thead>
        <tr>
            <th>Item Name</th>
            <th>Culture</th>
        </tr>
    </thead>
    <tbody>
        {{#each foodItems}}
        <tr>
            <td>{{this.itemName}}</td>
            <td>{{this.cultureName}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>

