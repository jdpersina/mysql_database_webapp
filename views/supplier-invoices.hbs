<h1>Supplier Invoices</h1>

{{! READ table }}
<table>
    <thead>
        <tr>
            <th>Invoice ID</th>
            <th>Supplier Name</th>
            <th>Item Count</th>
            <th>Items in Order</th>
            <th>Delete Invoice?</th>
            <th>Edit Invoice?</th>
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the invoice details }}
        {{#each invoices}}
        <tr>
            <td>{{this.supplierInvoiceID}}</td>
            <td>{{this.supplierName}}</td>
            <td>{{this.itemCount}}</td>
            <td>{{this.items}}</td>

            {{! DELETE form }}
            <form id='delete_invoice_form' method='POST' action='/invoices/suppliers/delete'>
                <input type='hidden' name='delete_invoice_id' value='{{this.supplierInvoiceID}}' />
                <td>
                    <button type='submit' class='btn-delete'>
                        Delete
                    </button>
                </td>
            </form>
            {{! EDIT}}
            <td>
                <a href='/invoices/suppliers/edit/{{this.supplierInvoiceID}}'>
                    <button type='button' class='btn-secondary'>Edit</button>
                </a>
            </td>
        </tr>
        {{/each}}
    </tbody>
</table>

{{! CREATE form }}
<form class='cuForm' id='create_invoice_form' method='POST' action='/invoices/suppliers/add'>
    <label for='create_invoice_supplier'>Supplier: </label>
    <select name='create_invoice_supplier' id='create_invoice_supplier' required>
        <option value='' disabled selected>Select a Supplier</option>
        {{#each suppliers}}
        <option value='{{this.supplierID}}'>{{this.supplierName}}</option>
        {{/each}}
    </select>

    <label for='create_invoice_fooditem'>Food/Drink Item: </label>
    <select name='create_invoice_fooditem' id='create_invoice_fooditem' required>
        <option value='' disabled selected>Select an Item</option>
        {{#each foodItems}}
        <option value='{{this.foodItemID}}'>{{this.itemName}}</option>
        {{/each}}
    </select>

    <label for='create_invoice_quantity'>Quantity:</label>
    <input type='number' name='create_invoice_quantity' id='create_invoice_quantity' min='1' value='1' required />

    <input type='submit' value='Create Invoice' />
</form>

