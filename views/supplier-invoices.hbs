<h1>Supplier Invoices</h1>

{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{#each invoices.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
            <th></th>
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the invoice details }}
        {{#each invoices}}
        <tr>
            <td>{{this.invoiceID}}</td>
            <td>{{this.supplierName}}</td>
            <td>{{this.foodItemName}}</td>
            <td>{{this.quantity}}</td>
            <td>{{this.totalPrice}}</td>
            <td>{{this.invoiceDate}}</td>

            {{! DELETE form }}
            <form id='delete_invoice_form'>
                <input type='hidden' name='delete_invoice_id' value='{{this.invoiceID}}' />
                <td>
                    <button type='submit' class='btn-delete'>
                        Delete
                    </button>
                </td>
            </form>
        </tr>
        {{/each}}
    </tbody>
</table>

{{! CREATE form }}
<h2>Create New Supplier Invoice</h2>
<form class='cuForm' id='create_invoice_form'>
    <label for='create_invoice_supplier'>Supplier: </label>
    <select name='create_invoice_supplier' id='create_invoice_supplier' required>
        <option value='' disabled selected>Select a Supplier</option>
        {{#each suppliers}}
        <option value='{{this.supplierID}}'>{{this.supplierName}}</option>
        {{/each}}
    </select>

    <label for='create_invoice_fooditem'>Food/Drink Item: </label>
    <select name='create_invoice_fooditem' id='create_invoice_fooditem' required>
        <option value='' disabled selected>Select an Item</option>
        {{#each foodItems}}
        <option value='{{this.foodItemID}}'>{{this.itemName}} - {{this.price}} slips</option>
        {{/each}}
    </select>

    <label for='create_invoice_quantity'>Quantity:</label>
    <input type='number' name='create_invoice_quantity' id='create_invoice_quantity' min='1' value='1' required />

    <label for='create_invoice_date'>Invoice Date:</label>
    <input type='date' name='create_invoice_date' id='create_invoice_date' required />

    <input type='submit' value='Create Invoice' />
</form>

{{! UPDATE form }}
<h2>Update a Supplier Invoice</h2>
<form class='cuForm' id='update_invoice_form'>
    <label for='update_invoice_id'>Invoice to Update: </label>
    <select name='update_invoice_id' id='update_invoice_id' required>
        <option value='' disabled selected>Select an Invoice</option>
        {{#each invoices}}
        <option value='{{this.invoiceID}}'>
            Invoice #{{this.invoiceID}} - {{this.supplierName}} - {{this.foodItemName}}
        </option>
        {{/each}}
    </select>

    <label for='update_invoice_supplier'>Supplier: </label>
    <select name='update_invoice_supplier' id='update_invoice_supplier'>
        <option value='' disabled selected>Select a Supplier</option>
        {{#each suppliers}}
        <option value='{{this.supplierID}}'>{{this.supplierName}}</option>
        {{/each}}
    </select>

    <label for='update_invoice_fooditem'>Food/Drink Item: </label>
    <select name='update_invoice_fooditem' id='update_invoice_fooditem'>
        <option value='' disabled selected>Select an Item</option>
        {{#each foodItems}}
        <option value='{{this.foodItemID}}'>{{this.itemName}} - {{this.price}} slips</option>
        {{/each}}
    </select>

    <label for='update_invoice_quantity'>Quantity: </label>
    <input type='number' name='update_invoice_quantity' id='update_invoice_quantity' min='1' />

    <label for='update_invoice_date'>Invoice Date: </label>
    <input type='date' name='update_invoice_date' id='update_invoice_date' />

    <input type='submit' value='Update Invoice' />
</form>